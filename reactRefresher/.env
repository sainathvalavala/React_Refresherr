# Topic 46: environment variables. Only names starting with VITE_ reach the
# browser code (as import.meta.env.VITE_...). Never put secrets here: anything
# in browser code can be read by anyone. Machine-specific overrides go in
# .env.local, which .gitignore already excludes (*.local).
VITE_APP_TITLE=React Refresher
VITE_API_URL=https://jsonplaceholder.typicode.com
